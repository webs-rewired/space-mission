# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Web and desktop exports go in build/ (kept, with a .gdignore so Godot doesn't import what's exported there)
build/*
!build/.gdignore

text = "▶  Stop the spin"

[node name="KeyHints" parent="Right/Column" instance=ExtResource("9_keys")]
layout_mode = 2
alignment = 0
hints = [["W A S D", "move"], ["E", "in"], ["Q", "out"], ["← → ↑ ↓", "turn"], ["Z C", "roll"], ["Shift", "fine"], ["R", "rate hold"], ["T", "fast-forward"]]

[node name="Lesson" type="Label" parent="Right/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.75, 0.83, 1)
theme_override_font_sizes/font_size = 11
text = "You and the station are both in orbit. Coming in from in front, you're a little slower than the station, so you slowly sink toward Earth (the Clohessy-Wiltshire equations NASA plans rendezvous with). Keep nudging up."
autowrap_mode = 3

[node name="Status" type="Label" parent="."]

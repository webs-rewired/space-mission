[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/belt_hud.gd" id="1_hud"]

[sub_resource type="StyleBoxFlat" id="hud_style"]
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0
bg_color = Color(0.03, 0.04, 0.07, 0.82)
border_width_left = 1
border_width_top = 2
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.75, 0.3, 0.8)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="fuel_back"]
bg_color = Color(0.12, 0.13, 0.18, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="fuel_fill"]
bg_color = Color(1, 0.75, 0.3, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="BeltHud" type="PanelContainer"]
mouse_filter = 2
theme_override_styles/panel = SubResource("hud_style")
script = ExtResource("1_hud")
editor_description = "Piloting through a belt: thruster fuel, science shards, combo and close calls (launch.gd fills it in)."

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Column"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(1, 0.82, 0.3, 1)
theme_override_font_sizes/font_size = 18
text = "MANUAL CONTROL  ·  DODGE THE ROCKS, GRAB THE SHARDS"
horizontal_alignment = 1

[node name="Row" type="HBoxContainer" parent="Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12
alignment = 1

[node name="FuelTitle" type="Label" parent="Column/Row"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_font_sizes/font_size = 11
text = "THRUSTER FUEL"
vertical_alignment = 1

[node name="FuelBar" type="ProgressBar" parent="Column/Row"]
custom_minimum_size = Vector2(150, 10)
layout_mode = 2
size_flags_vertical = 4
theme_override_styles/background = SubResource("fuel_back")
theme_override_styles/fill = SubResource("fuel_fill")
value = 100.0
show_percentage = false

[node name="Shards" type="Label" parent="Column/Row"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(0.5, 1, 0.88, 1)
theme_override_font_sizes/font_size = 12
text = "SHARDS 0"
vertical_alignment = 1

[node name="CloseCalls" type="Label" parent="Column/Row"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(1, 0.85, 0.55, 1)
theme_override_font_sizes/font_size = 12
text = "CLOSE CALLS 0"
vertical_alignment = 1

[node name="Combo" type="Label" parent="Column/Row"]
visible = false
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(0.5, 1, 0.88, 1)
theme_override_font_sizes/font_size = 18
text = "3× COMBO"
vertical_alignment = 1

[node name="Hint" type="Label" parent="Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.76, 0.84, 1)
theme_override_font_sizes/font_size = 12
text = "WASD / arrows fire the thrusters. You keep drifting until you push the other way."
horizontal_alignment = 1

[gd_scene load_steps=12 format=3]

[ext_resource type="Texture2D" path="res://assets/textures/2k_stars_milky_way.jpg" id="90_stars"]
[ext_resource type="Script" path="res://scripts/gravity_assist.gd" id="1_planner"]
[ext_resource type="Script" path="res://scripts/assist_map.gd" id="2_map"]
[ext_resource type="Script" path="res://scripts/flyby_closeup.gd" id="3_closeup"]
[ext_resource type="PackedScene" path="res://scenes/key_hints.tscn" id="4_keys"]
[ext_resource type="Script" path="res://scripts/reach_meter.gd" id="5_reach"]
[ext_resource type="Shader" path="res://shaders/codex_thumbnail.gdshader" id="6_ball"]

[sub_resource type="ShaderMaterial" id="closeup_planet"]
shader = ExtResource("6_ball")
shader_parameter/tint = Color(1, 1, 1, 1)
shader_parameter/has_map = true
shader_parameter/edge_color = Color(0.45, 0.8, 1, 0.45)
shader_parameter/turn = 0.0

[sub_resource type="ShaderMaterial" id="map_planet"]
shader = ExtResource("6_ball")
shader_parameter/tint = Color(1, 1, 1, 1)
shader_parameter/has_map = true
shader_parameter/edge_color = Color(0.45, 0.8, 1, 0.6)
shader_parameter/turn = 0.0

[sub_resource type="StyleBoxFlat" id="panel_style"]
content_margin_left = 14.0
content_margin_top = 12.0
content_margin_right = 14.0
content_margin_bottom = 12.0
bg_color = Color(0.03, 0.05, 0.09, 0.92)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.45, 0.8, 1, 0.3)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="note_style"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(0.08, 0.07, 0.03, 0.9)
border_width_left = 3
border_color = Color(1, 0.82, 0.35, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="GravityAssist" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_planner")
editor_description = "Minigame: the gravity-assist planner (gravity_assist.gd, physics in flyby_physics.gd). Opened from the rocket builder's Gravity assist button; a good plan lowers the launch speed the rocket needs."

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.015, 0.02, 0.035, 1)

[node name="Stars" type="TextureRect" parent="."]
modulate = Color(1, 1, 1, 0.22)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("90_stars")
expand_mode = 1
stretch_mode = 6

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 20.0
offset_top = 12.0
offset_right = -20.0
offset_bottom = 52.0
grow_horizontal = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 24
text = "GRAVITY-ASSIST PLANNER"
vertical_alignment = 1

[node name="CloseButton" type="Button" parent="Header"]
custom_minimum_size = Vector2(110, 34)
layout_mode = 2
text = "Close (Esc)"

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 60.0
offset_right = -20.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14

[node name="LeftScroll" type="ScrollContainer" parent="Layout"]
custom_minimum_size = Vector2(318, 0)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Left" type="VBoxContainer" parent="Layout/LeftScroll"]
custom_minimum_size = Vector2(306, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 7

[node name="Goal" type="Label" parent="Layout/LeftScroll/Left"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Swing past a planet to speed up toward Jupiter."
autowrap_mode = 3

[node name="Steps" type="Label" parent="Layout/LeftScroll/Left"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_font_sizes/font_size = 12
text = "1  Pick a planet"
autowrap_mode = 3

[node name="PlanetPicker" type="OptionButton" parent="Layout/LeftScroll/Left"]
layout_mode = 2
focus_mode = 0
clip_text = true

[node name="PlanetNote" type="Label" parent="Layout/LeftScroll/Left"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.74, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "Cassini flew past Venus twice."
autowrap_mode = 3

[node name="AltitudeValue" type="Label" parent="Layout/LeftScroll/Left"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_font_sizes/font_size = 12
text = "Closest pass: 1,000 km"
autowrap_mode = 3

[node name="Altitude" type="HSlider" parent="Layout/LeftScroll/Left"]
layout_mode = 2
focus_mode = 0
max_value = 1.0
step = 0.001
value = 0.6

[node name="SideButton" type="Button" parent="Layout/LeftScroll/Left"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
focus_mode = 0
text = "Swing: counterclockwise (F to switch)"

[node name="BurnValue" type="Label" parent="Layout/LeftScroll/Left"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_font_sizes/font_size = 12
text = "Engine burn at the closest point: 0.00 km/s"
autowrap_mode = 3

[node name="Burn" type="HSlider" parent="Layout/LeftScroll/Left"]
layout_mode = 2
focus_mode = 0
max_value = 1.0
step = 0.01

[node name="Buttons" type="HBoxContainer" parent="Layout/LeftScroll/Left"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ExecuteButton" type="Button" parent="Layout/LeftScroll/Left/Buttons"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
text = "Execute flyby"

[node name="WindowButton" type="Button" parent="Layout/LeftScroll/Left/Buttons"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
text = "New window"

[node name="ClearButton" type="Button" parent="Layout/LeftScroll/Left"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 12
text = "Fly direct instead (no gravity assist)"

[node name="KeyHints" parent="Layout/LeftScroll/Left" instance=ExtResource("4_keys")]
layout_mode = 2
hints = [["A D", "pass height"], ["F", "switch side"], ["W S", "burn"], ["Q E", "planet"], ["Space", "execute"], ["N", "new window"]]

[node name="Middle" type="VBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="MapTitle" type="Label" parent="Layout/Middle"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(0.45, 0.8, 1, 1)
theme_override_font_sizes/font_size = 11
text = "YOUR ORBIT AROUND THE SUN (TO SCALE)"

[node name="Map" type="Control" parent="Layout/Middle"]
clip_contents = true
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("2_map")

[node name="FlybyDisc" type="TextureRect" parent="Layout/Middle/Map"]
material = SubResource("map_planet")
layout_mode = 0
offset_right = 16.0
offset_bottom = 16.0
mouse_filter = 2
expand_mode = 1

[node name="Note" type="Label" parent="Layout/Middle"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.55, 0.62, 1)
theme_override_font_sizes/font_size = 10
text = "Passing behind a planet (it pulls you along) speeds you up; passing in front slows you down. Closer passes bend your path more: δ = 2·asin(1 / (1 + rp·v∞² / μ)), and a burn at the closest point counts for extra (the Oberth effect). Real numbers: planet masses, sizes and orbits from NASA JPL. Simplified: circular orbits in one plane, one flyby instead of a chain."
autowrap_mode = 3

[node name="Right" type="VBoxContainer" parent="Layout"]
custom_minimum_size = Vector2(290, 0)
layout_mode = 2
theme_override_constants/separation = 8

[node name="ReachTitle" type="Label" parent="Layout/Right"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(1, 0.82, 0.35, 1)
theme_override_font_sizes/font_size = 11
text = "DOES IT REACH?"

[node name="Reach" type="Control" parent="Layout/Right"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
mouse_filter = 2
script = ExtResource("5_reach")

[node name="CloseupTitle" type="Label" parent="Layout/Right"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(0.45, 0.8, 1, 1)
theme_override_font_sizes/font_size = 11
text = "THE FLYBY, SEEN FROM THE PLANET"

[node name="Closeup" type="Control" parent="Layout/Right"]
clip_contents = true
custom_minimum_size = Vector2(0, 190)
layout_mode = 2
script = ExtResource("3_closeup")

[node name="PlanetDisc" type="TextureRect" parent="Layout/Right/Closeup"]
show_behind_parent = false
material = SubResource("closeup_planet")
layout_mode = 0
offset_right = 60.0
offset_bottom = 60.0
mouse_filter = 2
expand_mode = 1

[node name="Readouts" type="Label" parent="Layout/Right"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_font_sizes/font_size = 11
text = "ARRIVAL SPEED"
autowrap_mode = 3

[node name="Result" type="PanelContainer" parent="Layout/Right"]
layout_mode = 2
theme_override_styles/panel = SubResource("panel_style")

[node name="Column" type="VBoxContainer" parent="Layout/Right/Result"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Layout/Right/Result/Column"]
layout_mode = 2

[node name="StressTitle" type="Label" parent="CollectStage/Side/Column"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_font_sizes/font_size = 11
text = "STRAIN ON THE ARM"

[node name="StressBar" type="ProgressBar" parent="CollectStage/Side/Column"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
theme_override_styles/background = SubResource("bar_back")
theme_override_styles/fill = SubResource("stress_fill")
show_percentage = false

[node name="Spacer" type="Control" parent="CollectStage/Side/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="SkipButton" type="Button" parent="CollectStage/Side/Column"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
text = "Let the arm team do it"

[node name="IdentifyStage" type="HBoxContainer" parent="."]
layout_mode = 1

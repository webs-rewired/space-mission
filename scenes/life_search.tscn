[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/key_hints.tscn" id="91_keys"]
[ext_resource type="Texture2D" path="res://assets/textures/2k_stars_milky_way.jpg" id="90_stars"]
[ext_resource type="Script" path="res://scripts/life_search.gd" id="1_search"]
[ext_resource type="Script" path="res://scripts/life_scan_view.gd" id="2_view"]

[sub_resource type="StyleBoxFlat" id="panel_style"]
content_margin_left = 16.0
content_margin_top = 14.0
content_margin_right = 16.0
content_margin_bottom = 14.0
bg_color = Color(0.03, 0.05, 0.09, 0.94)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.45, 0.8, 1, 0.4)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="view_frame"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.86, 0.5, 0.45)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="bar_back"]
bg_color = Color(0.1, 0.13, 0.2, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="power_fill"]
bg_color = Color(0.45, 1, 0.65, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="LifeSearch" type="Control"]
editor_description = "Minigame: the search for signs of life (life_search.gd, real findings in life_signs.gd, the close-up in life_scan_view.gd). surface_view.gd opens it at a target where life could exist."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_search")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.015, 0.03, 1)

[node name="Stars" type="TextureRect" parent="."]
modulate = Color(1, 1, 1, 0.22)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("90_stars")
expand_mode = 1
stretch_mode = 6

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 24.0
offset_top = 14.0
offset_right = -24.0
offset_bottom = 54.0
grow_horizontal = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 24
text = "SIGNS OF LIFE"
vertical_alignment = 1
clip_text = true

[node name="Stage" type="Label" parent="Header"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(0.45, 0.8, 1, 1)
theme_override_font_sizes/font_size = 13
text = "1  SCAN     ›     2  WEIGH     ›     3  VERDICT"
vertical_alignment = 1

[node name="ScanStage" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 64.0
offset_right = -24.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2

[node name="ScanView" type="Control" parent="ScanStage"]
clip_contents = true
layout_mode = 1
anchor_right = 0.64
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_view")

[node name="Frame" type="Panel" parent="ScanStage/ScanView"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("view_frame")

[node name="Side" type="PanelContainer" parent="ScanStage"]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.66
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 0
grow_vertical = 2
theme_override_styles/panel = SubResource("panel_style")

[node name="Column" type="VBoxContainer" parent="ScanStage/Side"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="Kicker" type="Label" parent="ScanStage/Side/Column"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(0.45, 0.8, 1, 1)
theme_override_font_sizes/font_size = 11
text = "STEP 1  ·  MAP THE SURFACE"

[node name="Brief" type="Label" parent="ScanStage/Side/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.83, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Brief"
autowrap_mode = 3

[node name="Instruments" type="HBoxContainer" parent="ScanStage/Side/Column"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="InstrumentNote" type="Label" parent="ScanStage/Side/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.74, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "Close-up camera"
autowrap_mode = 3

[node name="PowerTitle" type="Label" parent="ScanStage/Side/Column"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_font_sizes/font_size = 11
text = "POWER FOR MAPPING"

[node name="PowerBar" type="ProgressBar" parent="ScanStage/Side/Column"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
theme_override_styles/background = SubResource("bar_back")
theme_override_styles/fill = SubResource("power_fill")
value = 100.0
show_percentage = false

[node name="FoundTitle" type="Label" parent="ScanStage/Side/Column"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(1, 0.86, 0.5, 1)
theme_override_font_sizes/font_size = 11
text = "EVIDENCE FOUND"

[node name="Found" type="Label" parent="ScanStage/Side/Column"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_font_sizes/font_size = 12
text = "Nothing found yet."
autowrap_mode = 3

[node name="Status" type="Label" parent="ScanStage/Side/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 1, 0.8, 1)
theme_override_font_sizes/font_size = 12
text = "Hold SPACE to map with the selected instrument."
autowrap_mode = 3

[node name="KeyHints" parent="ScanStage/Side/Column" instance=ExtResource("91_keys")]
layout_mode = 2
alignment = 0
hints = [["W A S D", "move"], ["Space", "map"], ["1 2 3", "instrument"]]

[node name="Spacer" type="Control" parent="ScanStage/Side/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="DoneButton" type="Button" parent="ScanStage/Side/Column"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
focus_mode = 0
text = "Done mapping: weigh the evidence  ›"

[node name="WeighStage" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 64.0
offset_right = -24.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="WeighStage"]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.12
anchor_right = 0.88
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("panel_style")

[node name="Column" type="VBoxContainer" parent="WeighStage/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Kicker" type="Label" parent="WeighStage/Panel/Column"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(0.45, 0.8, 1, 1)
theme_override_font_sizes/font_size = 11
text = "STEP 2  ·  WEIGH THE EVIDENCE"

[node name="Note" type="Label" parent="WeighStage/Panel/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "For each piece of evidence: could it be life, or something else?"
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="WeighStage/Panel/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Cards" type="VBoxContainer" parent="WeighStage/Panel/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="NextButton" type="Button" parent="WeighStage/Panel/Column"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
focus_mode = 0
text = "On to the verdict  ›"

[node name="VerdictStage" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 64.0
offset_right = -24.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14

[node name="Ladder" type="PanelContainer" parent="VerdictStage"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("panel_style")

[node name="Column" type="VBoxContainer" parent="VerdictStage/Ladder"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Kicker" type="Label" parent="VerdictStage/Ladder/Column"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(0.45, 0.8, 1, 1)
theme_override_font_sizes/font_size = 11
text = "THE CONFIDENCE OF LIFE DETECTION (CoLD) SCALE"

[node name="About" type="Label" parent="VerdictStage/Ladder/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.74, 0.82, 1)
theme_override_font_sizes/font_size = 12
text = "NASA scientists proposed this ladder in 2021 for judging any claim of life beyond Earth. Each rung needs the ones below it."
autowrap_mode = 3

[node name="Rungs" type="RichTextLabel" parent="VerdictStage/Ladder/Column"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
fit_content = true
theme_override_font_sizes/normal_font_size = 14
theme_override_font_sizes/italics_font_size = 12
text = "7  Independent teams confirm it"

[node name="Verdict" type="PanelContainer" parent="VerdictStage"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("panel_style")

[node name="Column" type="VBoxContainer" parent="VerdictStage/Verdict"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Kicker" type="Label" parent="VerdictStage/Verdict/Column"]
layout_mode = 2
theme_type_variation = &"DataLabel"
theme_override_colors/font_color = Color(1, 0.86, 0.5, 1)
theme_override_font_sizes/font_size = 11
text = "STEP 3  ·  WHAT DO YOU TELL THE WORLD?"

[node name="Buttons" type="VBoxContainer" parent="VerdictStage/Verdict/Column"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Result" type="Label" parent="VerdictStage/Verdict/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

[node name="Spacer" type="Control" parent="VerdictStage/Verdict/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="ContinueButton" type="Button" parent="VerdictStage/Verdict/Column"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
focus_mode = 0
text = "Back to driving"

[node name="LaunchComplex" type="Node3D"]
editor_description = "The launch site, laid out like Launch Complex 39B at Kennedy Space Center: flame trench, three lightning towers, the water tower, fuel spheres, the crawlerway to the Vehicle Assembly Building and the Atlantic. The script adds the rocket and its mobile launcher. Made by tools/make_places.py."


# Which samples can turn up on each world (worlds not listed use the rocky or icy set)
const WORLD_SAMPLES = {
	"Mars": ["basalt", "olivine_rock", "hematite", "gypsum", "clay"],
	"Moon": ["basalt", "anorthosite", "ilmenite_basalt", "orange_glass", "breccia"],

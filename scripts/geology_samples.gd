	"Titan": ["ice_pebbles", "organic_haze", "water_ice", "methane_ice"],
	"Ceres": ["carbonate", "ammonia_clay", "water_ice", "clay"],
	"Io": ["sulfur", "so2_frost", "basalt", "olivine_rock"],
	"Pluto": ["nitrogen_ice", "methane_ice", "water_ice", "organic_haze"],
	"Triton": ["nitrogen_ice", "methane_ice", "water_ice", "organic_haze"],
	"Ganymede": ["water_ice", "sea_salt", "sulfate_salt", "organic_haze"],   # Juno's JIRAM found salts and organics (2023)
	"Callisto": ["water_ice", "clay", "organic_haze", "breccia"],
	"Charon": ["water_ice", "organic_haze", "methane_ice", "breccia"],       # Pluto's escaping methane freezes at its pole
	"Titania": ["water_ice", "organic_haze", "breccia", "clay"],
}
const ROCKY_SET = ["basalt", "olivine_rock", "breccia", "clay"]
const ICY_SET = ["water_ice", "organic_haze", "methane_ice", "nitrogen_ice"]

static func samples_for(world):
	if WORLD_SAMPLES.has(world):
		return WORLD_SAMPLES[world]
	if world in ["Eris", "Haumea", "Makemake"]:
		return ICY_SET
	return ROCKY_SET

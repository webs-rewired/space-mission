[gd_resource type="Theme" load_steps=11 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Inter-Variable.ttf" id="1_inter"]
[ext_resource type="FontFile" path="res://assets/fonts/BarlowCondensed-SemiBold.ttf" id="2_barlow"]
[ext_resource type="FontFile" path="res://assets/fonts/JetBrainsMono-Variable.ttf" id="3_mono"]
[ext_resource type="FontFile" path="res://assets/fonts/Orbitron-Variable.ttf" id="4_orbitron"]

[sub_resource type="FontVariation" id="body_font"]
base_font = ExtResource("1_inter")
variation_opentype = {2003265652: 420}
opentype_features = {1953396077: 1}

[sub_resource type="FontVariation" id="body_bold_font"]
base_font = ExtResource("1_inter")
variation_opentype = {2003265652: 650}
opentype_features = {1953396077: 1}

[sub_resource type="FontVariation" id="heading_font"]
base_font = ExtResource("2_barlow")
spacing_glyph = 1

[sub_resource type="FontVariation" id="data_font"]
base_font = ExtResource("3_mono")
variation_opentype = {2003265652: 500}

[sub_resource type="FontVariation" id="logo_font"]
base_font = ExtResource("4_orbitron")
variation_opentype = {2003265652: 700}
spacing_glyph = 6

[sub_resource type="StyleBoxFlat" id="tooltip_style"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0
bg_color = Color(0.04, 0.06, 0.1, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.45, 0.8, 1, 0.5)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[resource]
default_font = SubResource("body_font")
default_font_size = 16
Button/font_sizes/font_size = 19
Button/fonts/font = SubResource("heading_font")
CheckButton/fonts/font = SubResource("body_font")
DataLabel/base_type = &"Label"
DataLabel/font_sizes/font_size = 15
DataLabel/fonts/font = SubResource("data_font")
LogoLabel/base_type = &"Label"
LogoLabel/font_sizes/font_size = 56
LogoLabel/fonts/font = SubResource("logo_font")
MenuButton/fonts/font = SubResource("heading_font")
OptionButton/font_sizes/font_size = 18
OptionButton/fonts/font = SubResource("heading_font")
PopupMenu/fonts/font = SubResource("body_font")
RichTextLabel/fonts/bold_font = SubResource("body_bold_font")
RichTextLabel/fonts/mono_font = SubResource("data_font")
RichTextLabel/fonts/normal_font = SubResource("body_font")
TitleLabel/base_type = &"Label"
TitleLabel/font_sizes/font_size = 26
TitleLabel/fonts/font = SubResource("heading_font")
TooltipPanel/styles/panel = SubResource("tooltip_style")
